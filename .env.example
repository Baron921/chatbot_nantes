# Configuration du Chatbot Nantes Métropole
# Choisissez l'un des fournisseurs ci-dessous :

# 1. Google Gemini (Recommandé - Clé gratuite disponible sur https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI (Alternative - Clé sur https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Port du serveur de développement (par défaut: 3000)
PORT=3000
